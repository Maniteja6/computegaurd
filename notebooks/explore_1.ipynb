    "import pandas as pd\n",
    "import os\n",
    "\n",
    "raw_dir = \"../data/raw\"\n",
    "\n",
    "files = sorted([f for f in os.listdir(raw_dir) if f.endswith(\".csv\")])\n",
    "\n",
    "print(f\"Total daily files: {len(files)}\")\n",
    "\n",
    "df = pd.read_csv(os.path.join(raw_dir, files[0]))\n",
    "\n",
    "print(f\"shape: {df.shape}\")\n",
    "\n",
    "df.head()"
